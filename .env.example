# Copy to .env and fill in. NEVER commit the .env file.
TRADING_MODE=paper                 # paper | live
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=
BITGET_PRODUCT_TYPE=USDT-FUTURES   # bitget v2 product type
BASE_EQUITY_USDT=1000              # paper-mode starting equity
MAX_GROSS_LEVERAGE=3.0
CVAR_ALPHA=0.05
CVAR_FLOOR_PCT=-0.08               # ES_5% must stay >= -8% per position
WALK_FORWARD_TRAIN_DAYS=30
WALK_FORWARD_TEST_DAYS=7
RECALIBRATION_MAX_ATTEMPTS=3
LOG_LEVEL=INFO
UI_HOST=127.0.0.1
UI_PORT=8050
